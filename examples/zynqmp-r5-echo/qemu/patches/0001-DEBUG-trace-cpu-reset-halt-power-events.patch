From f1bfed0da1c38ab8fd78704b92774d7480f019e1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 13:00:20 +0100
Subject: [PATCH] DEBUG: trace cpu reset/halt/power events

---
 accel/tcg/cpu-exec.c    | 4 ++++
 hw/core/cpu-exec-gpio.c | 5 +++++
 target/arm/cpu.c        | 5 +++++
 3 files changed, 14 insertions(+)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index e2231d1..b85b084 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -18,6 +18,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/timer.h"
 #include "qemu/qemu-print.h"
 #include "qapi/error.h"
 #include "qapi/type-helpers.h"
@@ -710,6 +711,9 @@ static inline bool cpu_handle_halt(CPUState *cpu)
         if (!cpu_has_work(cpu) || cpu->reset_pin) {
             return true;
         }
+        if (cpu->cpu_index >= 4 || cpu->halt_pin || cpu->arch_halt_pin) {
+            fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cpu->cpu_index, "halt_wake", -1, cpu->reset_pin, cpu->halt_pin, cpu->arch_halt_pin, cpu->halted, cpu->interrupt_request);
+        }
 
         cpu->halted = 0;
     }
diff --git a/hw/core/cpu-exec-gpio.c b/hw/core/cpu-exec-gpio.c
index b6dfa68..2fef04b 100644
--- a/hw/core/cpu-exec-gpio.c
+++ b/hw/core/cpu-exec-gpio.c
@@ -32,6 +32,7 @@ static void cpu_set_off(CPUState *cpu, run_on_cpu_data data)
 {
     assert(qemu_mutex_iothread_locked());
 
+    fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cpu->cpu_index, "set_off", -1, cpu->reset_pin, cpu->halt_pin, cpu->arch_halt_pin, cpu->halted, cpu->interrupt_request);
     cpu->halted = 1;
     cpu->exception_index = EXCP_HLT;
 
@@ -44,6 +45,7 @@ static void cpu_set_on(CPUState *cpu, run_on_cpu_data data)
 {
     assert(qemu_mutex_iothread_locked());
 
+    fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cpu->cpu_index, "set_on", -1, cpu->reset_pin, cpu->halt_pin, cpu->arch_halt_pin, cpu->halted, cpu->interrupt_request);
     cpu->halted = 0;
 
 #ifdef TARGET_ARM
@@ -65,6 +67,7 @@ static void cpu_reset_enter(CPUState *cpu, run_on_cpu_data data)
 static void cpu_reset_exit(CPUState *cpu, run_on_cpu_data data)
 {
     /* Initialize the cpu we are turning on */
+    fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cpu->cpu_index, "reset_exit", -1, cpu->reset_pin, cpu->halt_pin, cpu->arch_halt_pin, cpu->halted, cpu->interrupt_request);
     cpu_reset(cpu);
 }
 
@@ -108,6 +111,7 @@ void cpu_reset_gpio(void *opaque, int irq, int level)
 
     g_assert(lock_count == 0);
     lock_count++;
+    fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cpu->cpu_index, "reset_gpio", level, cpu->reset_pin, cpu->halt_pin, cpu->arch_halt_pin, cpu->halted, cpu->interrupt_request);
     if (level == cpu->reset_pin) {
         goto done;
     }
@@ -155,6 +159,7 @@ void cpu_halt_gpio(void *opaque, int irq, int level)
     CPUState *cpu = CPU(opaque);
 
     assert(qemu_mutex_iothread_locked());
+    fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cpu->cpu_index, "halt_gpio", level, cpu->reset_pin, cpu->halt_pin, cpu->arch_halt_pin, cpu->halted, cpu->interrupt_request);
     cpu->halt_pin = level;
     cpu_exec_pin_update(cpu, cpu->reset_pin); /* TBD: _sync not working */
 }
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 537cd95..1c94135 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -1089,6 +1089,7 @@ static void arm_cpu_set_ncpuhalt(void *opaque, int irq, int level)
         return;
     }
 #endif
+    fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cs->cpu_index, "ncpuhalt", level, cs->reset_pin, cs->halt_pin, cs->arch_halt_pin, cs->halted, cs->interrupt_request);
     cs->arch_halt_pin = level;
     /* As we set the powered_off status on CPU reset we need to make sure that
      * we unset it as well.
@@ -2632,6 +2633,10 @@ static void arm_cpu_pwr_cntrl(void *opaque, int n, int level)
     DeviceClass *dc_parent = DEVICE_CLASS(ARM_CPU_PARENT_CLASS);
     ARMCPU *cpu = ARM_CPU(opaque);
 
+    {
+        CPUState *cs = CPU(opaque);
+        fprintf(stderr, "DBG %8.3f cpu%d %s lvl=%d rst=%d halt=%d ahalt=%d halted=%d ir=%x\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, cs->cpu_index, "pwr_cntrl", level, cs->reset_pin, cs->halt_pin, cs->arch_halt_pin, cs->halted, cs->interrupt_request);
+    }
     cpu->power_state = level ? PSCI_ON : PSCI_OFF;
     dc_parent->pwr_cntrl(opaque, n, level);
 }
-- 
2.43.0

